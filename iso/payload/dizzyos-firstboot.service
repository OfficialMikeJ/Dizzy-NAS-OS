[Unit]
Description=DizzyOS first-boot setup (installs packages and services)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/opt/dizzyos/.install-complete

[Service]
Type=oneshot
ExecStart=/opt/dizzyos/install-dizzyos.sh
RemainAfterExit=true
TimeoutStartSec=3600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
